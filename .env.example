APP_NAME="Super Apps BSC"
APP_ENV=local
APP_VERSION=1.0.0
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_superapps
DB_USERNAME=root
DB_PASSWORD=

# Entitas bawaan instalasi ini: dibuka pertama oleh pengguna level holding dan
# menjadi pemilik data contoh saat db:seed. HERBAEMAS | HERBATECH | AEJ | ERDIGMA
BSC_DEFAULT_ENTITY=ERDIGMA
# false = instalasi satu entitas (terkunci di BSC_DEFAULT_ENTITY, tanpa pengalih & konsolidasi)
# true  = instalasi holding (pengalih entitas & Konsolidasi Holding untuk pengguna level holding)
BSC_HOLDING_MODE=false

# --- Keamanan ---------------------------------------------------------------
# Syarat kata sandi saat membuat/mengubah pengguna.
PASSWORD_MIN_LENGTH=10
# Periksa kata sandi ke basis data kebocoran publik (butuh akses internet).
PASSWORD_CHECK_LEAKED=false

# Akun Super Admin awal yang dibuat seeder pada instalasi baru.
# Biarkan tetap dikomentari untuk memakai nilai bawaan, lalu segera ganti
# kata sandinya lewat menu Manajemen Pengguna.
# SUPERADMIN_EMAIL=superadmin@perusahaan.co.id
# SUPERADMIN_PASSWORD=

# Content-Security-Policy (lihat config/security.php). Matikan hanya bila ada
# aset yang terblokir; CSP_REPORT_ONLY=true untuk memantau tanpa memblokir.
CSP_ENABLED=true
CSP_REPORT_ONLY=false
# Wajib true di produksi (HTTPS): cookie sesi tidak dikirim lewat HTTP polos.
SESSION_SECURE_COOKIE=false
# Enkripsi isi sesi yang tersimpan di basis data.
SESSION_ENCRYPT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
